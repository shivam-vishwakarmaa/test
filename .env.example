# Copy this file to `.env` and fill in the key(s) for the backend(s) you plan
# to run with `LLM_BACKEND=...`. `.env` is git-ignored -- never commit real
# keys. python-dotenv auto-loads `.env` when the scripts start (see
# scripts/run_llm_agent.py / run_judge_calibration.py).
#
# Only one of these is required, matching config/config.yaml's llm.backend
# (or its LLM_BACKEND env override):
#   backend=gemini    -> GEMINI_API_KEY   (default agent/judge models)
#   backend=anthropic -> ANTHROPIC_API_KEY
#   backend=cached    -> neither needed (replays the committed cache)
#   backend=ollama    -> neither needed (local daemon at localhost:11434)

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
